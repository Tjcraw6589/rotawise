      "ios": {
        "appleTeamId": "JA885J7PGW",
        "ascAppId": "6829975398"
      },
      "android": {
        "serviceAccountKeyPath": "./credentials/google-play-service-account.json",
        "track": "internal",
        "releaseStatus": "draft"
      }
